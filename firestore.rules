rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The single dogfood doctor account. Keep in sync with
    // kDoctorEmail in lib/features/consult/consult_config.dart.
    function isDoctor() {
      return request.auth != null
             && request.auth.token.email == 'jmone1@aol.com';
    }

    // Users — can only read/write their own profile.
    //
    // `premium` is the entitlement flag the AI cost gates read. It must
    // only be settable from the trusted server path (the RevenueCat
    // webhook). Allowing the owner to set it directly = free users mint
    // themselves Premium with one Firestore write. So we exclude
    // `premium`, `premiumSince`, and `premiumProductId` from the set of
    // fields the client may touch on update. Admin SDK (Cloud Functions)
    // bypasses rules entirely, so the webhook writer is unaffected.
    function isClientUpdatingForbiddenFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['premium', 'premiumSince', 'premiumProductId']);
    }
    function clientCreatePayloadIsClean() {
      return !request.resource.data.keys()
               .hasAny(['premium', 'premiumSince', 'premiumProductId']);
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                     && clientCreatePayloadIsClean();
      allow update: if request.auth != null && request.auth.uid == userId
                     && !isClientUpdatingForbiddenFields();
      allow delete: if false;

      // Tracking — nested under user, private to that user
      match /tracking/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Feeding log — private to user
      match /feeding/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Diaper log — private to user
      match /diapers/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Consultations reference — private to user
      match /consultations/{consultId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Lab results — private health data, user only
      match /labResults/{resultId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Milestone moments — photo + caption timeline, private to user.
      match /moments/{momentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Daily Brief — the agent's overnight summary. Server writes via
      // Cloud Functions; user reads their own.
      match /dailyBriefs/{briefId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // "Am I Okay" mood check-ins. Mom creates with the four whitelisted
      // fields; server-only fields (aiReply, voiceTranscript, flaggedCrisis,
      // updatedAt) are filled by the onMoodCheckinCreated trigger. Updates
      // from client are blocked — a check-in is a moment in time, not a
      // post. Delete is allowed (a venting entry should be erasable).
      match /moodCheckins/{checkinId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
                       && request.resource.data.keys().hasOnly(
                            ['level', 'note', 'voiceUrl', 'createdAt'])
                       && request.resource.data.level is int
                       && request.resource.data.level >= 1
                       && request.resource.data.level <= 5;
        allow update: if false; // server-only enrichment after create
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Aggregate mood state (7d/30d averages, hard-day streak, trend).
      // Server-only writes from the trigger; user reads own to drive the
      // Today's Debrief streak/silence prompts.
      match /moodState/{stateId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Cloud Functions only
      }

      // Montessori observations — Mom logs "I noticed ___" in 30s. The
      // onObservationCreated trigger runs a Claude tag pass and writes
      // back: sensitivePeriods[], montessoriCategory, milestoneIds[],
      // summary, taggedAt. Mom can edit the raw text/voiceUrl on her
      // own log; she cannot forge the server-applied tags.
      match /observations/{observationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
                       && request.resource.data.keys().hasOnly(
                            ['childId', 'note', 'voiceUrl', 'createdAt']);
        allow update: if request.auth != null && request.auth.uid == userId
                       && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['note']);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Daily Montessori invitations. One per child per day; the
      // generator Cloud Function composes from age + active sensitive
      // periods + recent observations. Server-only writes. Mom can
      // record her feedback (loved / lost interest / too early) and
      // mark it tried/completed — those are the only mutable fields.
      match /invitations/{invitationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
                       && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(
                              ['triedAt', 'feedback', 'feedbackAt']);
        allow create, delete: if false; // Cloud Functions only
      }
    }

    // Insights — users can read their own, Cloud Functions write
    match /insights/{insightId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // Only Cloud Functions
    }

    // Proactive notices — "The App That Notices". User reads their own
    // inbox; Cloud Functions write. Users may update only dismissedAt /
    // actedAt (never the content) and cannot delete — history is
    // preserved for the analytics needed by the D30 kill-criteria.
    match /notices/{userId} {
      // The parent doc itself can exist as a placeholder; only owner reads.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      match /items/{noticeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedAt', 'actedAt']);
        allow create, delete: if false; // Cloud Functions only
      }

      // Dedup sentinel docs — server-only (clients should never touch).
      match /_state/{stateId} {
        allow read, write: if false;
      }
    }

    // Balam Vault — family health documents. Owner creates items with
    // status 'pending'; the onVaultItemCreated Cloud Function processes
    // and updates status + extraction metadata server-side. Owner can
    // update the member tag / user-editable fields but NOT the
    // extraction payload. Delete allowed for owner (full vault control).
    match /vault/{userId}/items/{itemId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                     && request.resource.data.status == 'pending';
      allow update: if request.auth != null && request.auth.uid == userId
                     && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['memberId', 'userNote', 'userTags']);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Clinical audit log — Balam Box tier classifications. Server writes;
    // user can read their own records (for transparency); only licensed
    // clinicians (via server-side role check in Cloud Functions) may
    // update the mdReviewer* fields. Never deletable — this log is the
    // defense against any clinical-safety claim.
    match /clinical_audit/{caseId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false; // Cloud Functions only
    }

    // Emergency events — Balam Box Red-tier classifications. User can
    // read their own; only they can acknowledge (flip ackAt). Server
    // creates; never deleted.
    match /emergencies/{emergencyId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackAt']);
      allow create, delete: if false; // Cloud Functions only
    }

    // Community posts — any authenticated user can read, author can write
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null; // For likes (in production, use Cloud Functions)
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // Comments
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // Doctor consultations — async threads between a parent and the
    // dogfood doctor. The parent reads/writes their own; the doctor
    // reads/writes every consultation. Stored top-level so the doctor
    // can query across families.
    match /consultations/{consultId} {
      allow read: if request.auth != null
                   && (resource.data.uid == request.auth.uid || isDoctor());
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                     && (resource.data.uid == request.auth.uid || isDoctor());
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if request.auth != null
          && (get(/databases/$(database)/documents/consultations/$(consultId)).data.uid == request.auth.uid
              || isDoctor());
        allow update, delete: if false;
      }
    }

    // Vendors — public read, admin write
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if false; // Admin SDK only
    }

    // Products — public read, vendor write via Cloud Functions
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }
  }
}
